---
import { getCollection } from "astro:content";
import { withBase } from "../utils/url";
import MediaCard from "./MediaCard.astro";

const allItems = (await getCollection("media")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latestItems = allItems.slice(0, 3);
---

<section id="media" class="bg-surface-alt py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl font-extrabold text-ink-900 sm:text-4xl">影音專區</h2>
        <p class="mt-4 text-ink-600">看見邱建富，聽見彰化的聲音</p>
      </div>
      <a href={withBase("/media")} class="text-sm font-bold text-primary-600 hover:text-primary-700">查看全部 →</a>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {latestItems.map((item) => <MediaCard item={item} />)}
    </div>
  </div>
</section>

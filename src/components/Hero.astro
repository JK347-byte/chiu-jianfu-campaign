---
import { site } from "../data/site";
import { withBase } from "../utils/url";
---

<section id="hero" class="relative overflow-hidden bg-surface">
  <!-- 裝飾用漸層光暈，純 CSS，不需要圖片 -->
  <div
    class="pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full bg-primary-300/40 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <!--
    候選人形象照（桌面版）：滿版貼齊螢幕右側，左緣用漸層淡出融入背景色，
    不用外框、不用圓角卡片，效果類似「照片直接融進頁面」而不是「一張裝框的照片」。
    照片放在 public/images/，檔名對應 src/data/site.ts 的 hero.portrait，
    換照片只需要換檔案、改檔名字串，不用動這裡的排版。
  -->
  <div class="hero-photo-fade absolute inset-y-0 right-0 hidden w-[58%] lg:block" aria-hidden="false">
    <img
      src={withBase(site.hero.portrait)}
      alt={`${site.candidate.name}，${site.candidate.role}`}
      class="h-full w-full object-cover object-top"
    />
    <div class="absolute bottom-10 right-10 rounded-full bg-ink-900/90 px-5 py-2.5 text-sm font-bold text-primary-300 shadow-lg backdrop-blur-sm">
      {site.candidate.role}・{site.candidate.name}
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-28 lg:px-8">
    <div class="hero-fade-in max-w-xl">
      <p class="inline-block rounded-full bg-primary-100 px-4 py-1 text-sm font-bold text-primary-700">
        {site.candidate.role}・{site.candidate.party}
      </p>
      <h1 class="mt-6 text-4xl font-extrabold leading-tight text-ink-900 sm:text-5xl lg:text-6xl">
        {site.hero.slogan}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-ink-600">
        {site.hero.subtitle}
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={site.hero.primaryCta.href}
          class="rounded-full bg-accent-500 px-8 py-3.5 text-base font-bold text-white shadow-lg shadow-accent-500/30 transition-transform hover:scale-105 hover:bg-accent-600"
        >
          {site.hero.primaryCta.label}
        </a>
        <a
          href={site.hero.secondaryCta.href}
          class="rounded-full border-2 border-ink-900 px-8 py-3.5 text-base font-bold text-ink-900 transition-colors hover:bg-ink-900 hover:text-white"
        >
          {site.hero.secondaryCta.label}
        </a>
      </div>
    </div>

    <!-- 手機／平板版：照片改回正常區塊，淡出效果換成底部淡出，避免跟文字疊在一起看不清楚 -->
    <div class="hero-fade-in-delayed relative mx-auto mt-12 w-full max-w-md lg:hidden">
      <div class="hero-photo-fade-mobile relative aspect-[4/5] w-full overflow-hidden">
        <img
          src={withBase(site.hero.portrait)}
          alt={`${site.candidate.name}，${site.candidate.role}`}
          class="h-full w-full rounded-[2.5rem] object-cover object-top"
        />
      </div>
      <div class="mt-4 inline-block rounded-full bg-ink-900/90 px-5 py-2.5 text-sm font-bold text-primary-300">
        {site.candidate.role}・{site.candidate.name}
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-fade-in {
    animation: hero-fade-up 0.7s ease-out both;
  }

  .hero-fade-in-delayed {
    animation: hero-fade-up 0.7s ease-out 0.15s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade-in,
    .hero-fade-in-delayed {
      animation: none;
    }
  }

  /* 桌面版：照片左緣漸層淡出，融入 bg-surface 背景色，不做硬邊框 */
  .hero-photo-fade img {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 22%, black 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 22%, black 100%);
  }

  /* 手機版：圓角卡片底部淡出，柔化跟下方內容的交界 */
  .hero-photo-fade-mobile img {
    -webkit-mask-image: linear-gradient(to bottom, black 78%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 78%, transparent 100%);
  }
</style>

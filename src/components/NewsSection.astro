---
import { getCollection } from "astro:content";
import NewsCard from "./NewsCard.astro";
import { withBase } from "../utils/url";

const allPosts = (await getCollection("news")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latestPosts = allPosts.slice(0, 3);
---

<section id="news" class="py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl font-extrabold text-ink-900 sm:text-4xl">最新消息與行程</h2>
        <p class="mt-4 text-ink-600">掌握第一手競選動態</p>
      </div>
      <a href={withBase("/news")} class="text-sm font-bold text-primary-600 hover:text-primary-700">查看全部 →</a>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {latestPosts.map((post) => <NewsCard post={post} />)}
    </div>
  </div>
</section>

---
import { site } from "../data/site";
import { withBase } from "../utils/url";

const navItems = [
  { label: "首頁", href: withBase("/#hero") },
  { label: "關於邱建富", href: withBase("/#about") },
  { label: "施政成果的里程碑", href: withBase("/achievements") },
  { label: "核心政見", href: withBase("/#policies") },
  { label: "分區服務＿彰化八大生活圈", href: withBase("/#regions") },
  { label: "最新消息與相關報導", href: withBase("/news") },
  { label: "影音專區", href: withBase("/media") },
  { label: "支持我們", href: withBase("/#donate") },
];
---

<header class="sticky top-0 z-50 border-b border-primary-200 bg-surface/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href={withBase("/")} class="flex items-center gap-3">
      <span
        class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-500 font-bold text-ink-900"
      >
        {site.candidate.name.slice(0, 1)}
      </span>
      <span class="text-lg font-bold text-ink-900">{site.candidate.name}</span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-ink-700 transition-colors hover:text-primary-600"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#donate"
      class="hidden rounded-full bg-accent-500 px-5 py-2 text-sm font-bold text-white shadow-sm transition-transform hover:scale-105 hover:bg-accent-600 lg:inline-block"
    >
      支持捐款
    </a>

    <!-- 手機版選單開關 -->
    <button
      id="mobile-menu-button"
      class="flex h-10 w-10 items-center justify-center rounded-md border border-ink-200 lg:hidden"
      aria-label="開啟選單"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden flex-col gap-1 border-t border-primary-200 bg-surface px-4 py-3 lg:hidden">
    {
      navItems.map((item) => (
        <a href={item.href} class="rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-primary-50">
          {item.label}
        </a>
      ))
    }
    <a href="#donate" class="mt-2 rounded-full bg-accent-500 px-5 py-2 text-center text-sm font-bold text-white">
      支持捐款
    </a>
  </nav>
</header>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  button?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    menu?.classList.toggle("flex");
    button.setAttribute("aria-expanded", String(!!isHidden));
  });
</script>

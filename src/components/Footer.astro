---
import { site } from "../data/site";

const socialLinks = [
  { label: "Facebook", href: site.social.facebook },
  { label: "YouTube", href: site.social.youtube },
  { label: "Instagram", href: site.social.instagram },
  { label: "LINE", href: site.social.line },
];
---

<footer class="bg-ink-900 text-ink-100">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-3 lg:px-8">
    <div>
      <p class="text-xl font-bold text-primary-400">{site.candidate.name}</p>
      <p class="mt-1 text-sm text-ink-300">{site.candidate.role}・{site.candidate.party}</p>
      <p class="mt-4 text-sm leading-relaxed text-ink-300">{site.hero.slogan}</p>
    </div>

    <div>
      <p class="font-bold text-primary-400">聯絡資訊</p>
      <ul class="mt-3 space-y-1 text-sm text-ink-300">
        <li>{site.contact.officeAddress}</li>
        <li>{site.contact.phone}</li>
        <li>{site.contact.email}</li>
      </ul>
    </div>

    <div>
      <p class="font-bold text-primary-400">關注我們</p>
      <div class="mt-3 flex gap-3">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              class="rounded-full border border-ink-600 px-4 py-1.5 text-sm text-ink-200 transition-colors hover:border-primary-400 hover:text-primary-400"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="border-t border-ink-800 px-4 py-4 text-center text-xs text-ink-400 sm:px-6 lg:px-8">
    {site.footer.disclaimer}
  </div>
</footer>

---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const milestones = (await getCollection("achievements")).sort((a, b) => a.data.order - b.data.order);

const categoryStyles: Record<string, string> = {
  "重大建設": "bg-primary-100 text-primary-700",
  "市政治理": "bg-ink-100 text-ink-700",
  "民調肯定": "bg-accent-100 text-accent-700",
  "財政成果": "bg-accent-100 text-accent-700",
};
---

<BaseLayout
  title="施政成果里程碑"
  description={`${site.candidate.name}擔任彰化市長八年任內的施政成果與里程碑，附可查證來源`}
>
  <section class="bg-primary-800 py-20 text-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-bold text-primary-200">2010–2018</p>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">彰化市長八年施政里程碑</h1>
      <p class="mt-6 text-lg leading-relaxed text-primary-100">
        從就任第一天到卸任交接，這裡整理了{site.candidate.name}擔任彰化市長期間具代表性的施政成果。每一筆都附上可查證的公開報導來源，沒有把握的內容不刻意填滿。
      </p>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <ol class="relative space-y-10 border-l-2 border-primary-300 pl-8 sm:pl-10">
        {
          milestones.map((item) => (
            <li class="relative">
              <span class="absolute -left-[2.6rem] top-1 flex h-5 w-5 items-center justify-center rounded-full border-4 border-surface bg-primary-500 sm:-left-[3.1rem]" />

              <p class="text-sm font-bold text-primary-700">{item.data.year}</p>

              <div class="mt-1 flex flex-wrap items-center gap-3">
                <span
                  class={`rounded-full px-3 py-1 text-xs font-bold ${categoryStyles[item.data.category] ?? "bg-ink-100 text-ink-700"}`}
                >
                  {item.data.category}
                </span>
                {item.data.metric && <span class="text-2xl font-extrabold text-accent-600">{item.data.metric}</span>}
              </div>

              <h2 class="mt-2 text-xl font-bold text-ink-900">{item.data.title}</h2>
              <p class="mt-2 max-w-2xl leading-relaxed text-ink-600">{item.data.summary}</p>

              <a
                href={item.data.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-ink-400 underline decoration-dotted hover:text-primary-600"
              >
                證據來源：{item.data.sourceLabel} ↗
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsCard from "../../components/NewsCard.astro";

const allPosts = (await getCollection("news")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="最新消息">
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold text-ink-900 sm:text-4xl">最新消息與行程</h1>
    <p class="mt-4 text-ink-600">掌握邱建富最新動態與競選行程</p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {allPosts.map((post) => <NewsCard post={post} />)}
    </div>
  </section>
</BaseLayout>
